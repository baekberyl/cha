  box-shadow: 0 2px 16px rgba(0,0,0,0.04);
  transition: transform 0.3s;
}
.story-card:hover {
  transform: translateY(-4px);
}
.story-image {
  height: 180px;
  background: linear-gradient(135deg, #e8e0d4, #d4c8b8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: var(--ink);
  opacity: 0.3;
}
.story-content {
  padding: 24px;
}
.story-tag {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--brand-blue);
  margin-bottom: 8px;
}
.story-title {
  font-family: 'Black Han Sans', sans-serif;
  font-size: 16px;
  color: var(--ink);
  margin-bottom: 10px;
  line-height: 1.3;
}
.story-excerpt {
  font-size: 13px;
  color: var(--ink);
  opacity: 0.6;
  line-height: 1.6;
}
.story-link {
  display: inline-block;
  margin-top: 16px;
  font-size: 12px;
  font-weight: 600;
  color: var(--brand-blue);
  text-decoration: none;
  letter-spacing: 0.5px;
}

/* Postcard Preview Section */
.postcard-preview-section {
  background: var(--paper);
  padding: 100px 60px;
  border-top: 1px solid var(--rule);
}
.postcard-preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
}
.postcard-preview-title {
  font-family: 'Black Han Sans', sans-serif;
  font-size: 28px;
  color: var(--ink);
}
.postcard-preview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-bottom: 32px;
}
.postcard-preview-item {
  background: white;
  overflow: hidden;
  transition: transform 0.3s;
  border: 1px solid var(--rule);
}
.postcard-preview-item:hover {
  transform: translateY(-4px);
}
.postcard-preview-bar {
  height: 4px;
}
.postcard-preview-tag {
  padding: 8px 16px;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.postcard-preview-content {
  padding: 20px;
}
.postcard-preview-content p {
  font-size: 13px;
  line-height: 1.7;
  color: var(--ink);
  opacity: 0.7;
  margin-bottom: 12px;
}
.postcard-preview-meta {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
}
.postcard-preview-author {
  color: var(--brand-blue);
  font-weight: 600;
}
.postcard-preview-date {
  color: var(--ink);
  opacity: 0.35;
}

@media (max-width: 1024px) {
  .stories-grid { grid-template-columns: 1fr; }
  .postcard-preview-grid { grid-template-columns: 1fr; }
