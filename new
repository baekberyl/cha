  opacity: 0.5;
  margin-bottom: 12px;
}
.collab-date {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--ink);
  opacity: 0.4;
}

/* Special Visa */
.special-visa-section {
  margin-top: 48px;
  padding-top: 40px;
  border-top: 2px dashed var(--rule-mid);
}
.special-visa-header {
  margin-bottom: 24px;
}
.special-visa-title {
  font-family: 'Black Han Sans', sans-serif;
  font-size: 18px;
  color: var(--ink);
  margin-bottom: 4px;
}
.special-visa-subtitle {
  font-size: 12px;
  color: var(--ink);
  opacity: 0.4;
}
.visa-item.special {
  border: 2px solid transparent;
  background: linear-gradient(white, white) padding-box,
              linear-gradient(135deg, #c9a84c, #e8d5a3, #c9a84c) border-box;
  position: relative;
  overflow: hidden;
}
.visa-item.special::before {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 60px; height: 60px;
  background: linear-gradient(135deg, rgba(201, 168, 76, 0.15), transparent);
}
.visa-item.special.locked {
  opacity: 0.5;
  border: 2px dashed var(--rule-mid);
  background: white;
}
.visa-item.special.locked::before {
  display: none;
}
.visa-stamp {
  position: absolute;
  top: 12px; right: 12px;
  width: 48px; height: 48px;
  border-radius: 50%;
  border: 2px solid #c9a84c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Black Han Sans', sans-serif;
  font-size: 8px;
  color: #c9a84c;
  text-align: center;
  line-height: 1.2;
  transform: rotate(-12deg);
  opacity: 0.8;
}
.visa-item.special.locked .visa-stamp {
  border-color: var(--rule-mid);
  color: rgba(0,0,0,0.2);
  transform: none;
}
/* An inked stamp image stands on its own — drop the drawn circle around it. */
.visa-stamp.has-image {
  border: none;
  width: 64px; height: 48px;
  border-radius: 0;
}
.visa-stamp.has-image img {
  width: 100%; height: 100%;
  object-fit: contain;
  display: block;
}
.special-badge {
  display: inline-block;
  padding: 2px 8px;
  background: linear-gradient(135deg, #c9a84c, #e8d5a3);
  color: white;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 1px;
  border-radius: 2px;
  margin-bottom: 6px;
}

