<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chalkak Collective</title>
<link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --brand-blue: #1750A5;
  --brand-light: #CEE2F5;
  --paper: #FFFAF0;
  --ink: #1A1A1A;
  --dark-bg: #0A1628;
  --yellow: #FCE762;
  --orange: #EEB150;
  --pink: #EB459F;
  --green: #CCEE76;
  --purple: #7B5FA0;

  /* Blueprint rules. The blue hairline grid is the signature — three weights
     so the page reads as a drafted sheet rather than a stack of UI borders.
     Never draw a divider in neutral black; it kills the effect. */
  --rule: rgba(23, 80, 165, 0.18);        /* internal cell divisions */
  --rule-mid: rgba(23, 80, 165, 0.35);    /* component outlines */
  --rule-strong: rgba(23, 80, 165, 0.6);  /* major section + column boundaries */
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Inter', sans-serif;
  background: var(--dark-bg);
  color: var(--ink);
  overflow-x: hidden;
  /* `clip` holds back horizontal overflow without turning body into a scroll
     container the way `hidden` does — that container is what breaks sticky. */
  overflow-x: clip;
}
.font-display { font-family: 'Black Han Sans', sans-serif; }
.font-mono { font-family: 'JetBrains Mono', monospace; }

.scanlines::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,255,0.015) 2px, rgba(255,255,255,0.015) 4px);
  pointer-events: none;
  z-index: 9999;
}

.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 20px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(10, 22, 40, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,0.08);
  transform: translateY(-100%);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
}
.nav.revealed,
.nav:focus-within {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}
/* Touch devices have no hover — keep the bar permanently visible there. */
@media (hover: none) {
  .nav {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
}
.nav-logo {
  font-family: 'Black Han Sans', sans-serif;
  font-size: 18px;
  color: white;
  letter-spacing: 2px;
  cursor: pointer;
}
.nav-links {
  display: flex;
  gap: 32px;
  list-style: none;
}
.nav-links a {
  color: white;
  text-decoration: none;
  font-size: 12px;
  text-transform: lowercase;
  letter-spacing: 1px;
  opacity: 0.7;
  transition: opacity 0.3s;
  cursor: pointer;
}
.nav-links a:hover { opacity: 1; }
.nav-book {
  background: var(--brand-blue);
  color: white;
  border: none;
  padding: 10px 24px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1px;
  cursor: pointer;
  border-radius: 4px;
  transition: transform 0.2s;
}
.nav-book:hover { transform: translateY(-2px); }

.page {
  display: none;
  min-height: 100vh;
}
.page.active { display: block; }

.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 0 60px;
  position: relative;
  background: var(--dark-bg);
}
.hero-content {
  flex: 1;
  max-width: 600px;
}
.hero-label {
  font-size: 13px;
  color: white;
  opacity: 0.45;
  margin-bottom: 16px;
  letter-spacing: 2px;
}
.hero-title {
  font-family: 'Black Han Sans', sans-serif;
  font-size: 64px;
  color: white;
  line-height: 1.1;
  margin-bottom: 24px;
}
.hero-subtitle {
  font-size: 14px;
  color: white;
  opacity: 0.6;
  margin-bottom: 32px;
}
.hero-code {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: white;
  opacity: 0.25;
  line-height: 2;
  margin-bottom: 40px;
}
.hero-code .var { color: var(--brand-light); opacity: 0.8; }
.hero-buttons {
  display: flex;
  gap: 16px;
}
.btn-primary {
  background: var(--brand-blue);
  color: white;
  border: none;
  padding: 14px 32px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1px;
  cursor: pointer;
  border-radius: 4px;
  transition: all 0.3s;
}
.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(23, 80, 165, 0.4);
}
.btn-secondary {
  background: transparent;
  color: white;
  border: 1px solid rgba(255,255,255,0.3);
  padding: 14px 32px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1px;
  cursor: pointer;
  border-radius: 4px;
  transition: all 0.3s;
}
.btn-secondary:hover {
  border-color: white;
  background: rgba(255,255,255,0.05);
}

.hero-visual {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  perspective: 1000px;
}
.sd-card-container {
  position: relative;
  width: 360px;
  height: 360px;
  transform-style: preserve-3d;
  transition: transform 0.1s ease-out;
  cursor: pointer;
}
.sd-card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}
.sd-card-face {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  backface-visibility: hidden;
  filter: drop-shadow(0 20px 40px rgba(0,0,0,0.5));
}
.sd-card-face.back {
  transform: rotateY(180deg);
}
.sd-hint {
  margin-top: 32px;
  text-align: center;
  color: white;
  opacity: 0.4;
  font-size: 12px;
  letter-spacing: 1px;
}
/* Pulsing ring reads as "clickable" — the card opens on click, not on swipe. */
.sd-hint-click {
  width: 22px;
  height: 22px;
  margin: 10px auto 0;
  border: 1px solid rgba(255,255,255,0.6);
  border-radius: 50%;
  animation: clickPulse 2s ease-in-out infinite;
}
@keyframes clickPulse {
  0%, 100% { transform: scale(0.8); opacity: 0.3; }
  50%      { transform: scale(1);   opacity: 0.9; }
}
@media (prefers-reduced-motion: reduce) {
  .sd-hint-click { animation: none; opacity: 0.6; }
}

.mini-cards-container {
  display: none;
  position: relative;
  width: 100%;
  max-width: 720px;
  height: 300px;
  perspective: 1000px;
}
.mini-cards-container.active {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24px;
}
.mini-card {
  width: 100px;
  height: 140px;
  border-radius: 8px;
  cursor: pointer;
  position: relative;
  transform-style: preserve-3d;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 8px 32px rgba(0,0,0,0.4);
}
.mini-card:nth-child(1) {
  background: linear-gradient(145deg, #d4a04a, var(--orange));
  transform: rotateY(-25deg) translateZ(-40px) scale(0.85);
}
.mini-card:nth-child(2) {
  background: linear-gradient(145deg, #d14a8f, var(--pink));
  transform: rotateY(-8deg) translateZ(0px) scale(1);
}
.mini-card:nth-child(3) {
  background: linear-gradient(145deg, #b8d46a, var(--green));
  transform: rotateY(8deg) translateZ(0px) scale(1);
}
.mini-card:nth-child(4) {
  background: linear-gradient(145deg, #6b4f8f, var(--purple));
  transform: rotateY(25deg) translateZ(-40px) scale(0.85);
}
.mini-card:hover {
  transform: translateY(-20px) scale(1.12) rotateY(0deg) translateZ(60px) !important;
  z-index: 10;
}
.mini-cards-container:has(.mini-card:hover) .mini-card:not(:hover) {
  opacity: 0.5;
  transform: scale(0.9) !important;
}
.mini-card-label {
  position: absolute;
  bottom: -30px;
  left: 50%;
  transform: translateX(-50%);
  font-family: 'Black Han Sans', sans-serif;
  font-size: 11px;
  color: white;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.3s;
}
.mini-card:hover .mini-card-label {
  opacity: 1;
}
.mini-card-num {
  position: absolute;
  top: 8px; left: 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: rgba(255,255,255,0.6);
}

.flash-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: white;
  opacity: 0;
  pointer-events: none;
  z-index: 9998;
}
.flash-overlay.active {
  animation: flash 0.5s ease-out;
}
@keyframes flash {
  0% { opacity: 0; }
  50% { opacity: 1; }
  100% { opacity: 0; }
}

.transition-zone {
  height: 40vh;
  background: linear-gradient(180deg, var(--dark-bg), var(--brand-blue), var(--brand-light), var(--paper));
}

.origin-section {
  background: var(--paper);
  padding: 120px 60px;
  display: flex;
  gap: 80px;
  align-items: center;
}
.origin-left { flex: 1; }
.origin-right { flex: 1; }
.origin-title {
  font-family: 'Black Han Sans', sans-serif;
  font-size: 36px;
  color: var(--ink);
  margin-bottom: 24px;
}
.origin-text {
  font-size: 14px;
  line-height: 1.8;
  color: var(--ink);
  opacity: 0.7;
  margin-bottom: 24px;
}
.origin-link {
  color: var(--brand-blue);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1px;
}
.terminal-box {
  background: var(--brand-light);
  border-radius: 4px;
  padding: 24px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  line-height: 2;
  color: var(--ink);
}
.terminal-box .cmd { color: var(--brand-blue); font-weight: 500; }

.memories-section {
  background: var(--paper);
  padding: 80px 60px;
}
.memories-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  max-width: 1000px;
  margin: 0 auto;
}
.memory-card {
  background: white;
  border-radius: 4px;
  padding: 40px;
  box-shadow: 0 2px 16px rgba(0,0,0,0.04);
  transition: transform 0.3s;
}
.memory-card:hover {
  transform: translateY(-4px);
}
.memory-card h3 {
  font-family: 'Black Han Sans', sans-serif;
  font-size: 20px;
  margin-bottom: 12px;
  color: var(--ink);
}
.memory-card p {
  font-size: 14px;
  color: var(--ink);
  opacity: 0.6;
  margin-bottom: 20px;
}

.footer {
  background: var(--paper);
  border-top: 1px solid var(--rule);
  padding: 40px 60px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: var(--ink);
  opacity: 0.5;
}
.footer-links {
  display: flex;
  gap: 24px;
}
.footer-links a {
  color: var(--ink);
  text-decoration: none;
  transition: opacity 0.3s;
}
.footer-links a:hover { opacity: 0.7; }

.station-page {
  background: var(--paper);
  min-height: 100vh;
  padding-top: 80px;
}
/* ── Blueprint rules ──────────────────────────────────────────────────────
   A structural divider drawn as an element rather than a border, so it can
   draw itself in when the page enters — the same gesture as .station-top-bar.
   Horizontal rules were tried and pulled: bled across the sticky text column. */
.rule-v { position: relative; pointer-events: none; }
.rule-v::after {
  content: '';
  position: absolute;
  top: 0; bottom: 0; left: 0;
  width: 1px;
  background: var(--rule-strong);
  transform: scaleY(0);
  transform-origin: top center;
  transition: transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
}
.page.active .rule-v::after { transform: scaleY(1); }
.rule-v.hair::after { background: var(--rule); }
.station-top-bar {
  height: 4px;
  width: 0%;
  transition: width 0.6s ease;
}
.station-top-bar.active { width: 100%; }
.station-content {
  display: flex;
  align-items: flex-start;
  min-height: calc(100vh - 84px);
}
/* The package copy parks itself while the visuals scroll past on the right. */
.station-info {
  width: 40%;
  padding: 60px;
  position: sticky;
  top: 84px;
  align-self: flex-start;
  max-height: calc(100vh - 84px);
  overflow-y: auto;
}
.station-visual {
  width: 60%;
  position: relative;
}
/* The column boundary runs the full height of the section. It lives on the
   visual column, not on the sticky info column, so it cannot travel. */
.station-column-rule {
  position: absolute;
  top: 0; bottom: 0; left: 0;
  z-index: 2;
}
.station-tag {
  display: inline-block;
  padding: 6px 16px;
  border-radius: 4px;
  color: white;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  margin-bottom: 24px;
}
.station-name {
  font-family: 'Black Han Sans', sans-serif;
  font-size: 36px;
  color: var(--brand-blue);
  margin-bottom: 32px;
}
.station-price {
  font-size: 20px;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 24px;
}
.station-outputs {
  font-size: 14px;
  color: var(--ink);
  opacity: 0.6;
  line-height: 2;
  margin-bottom: 40px;
}
.station-visual-main {
  height: 50vh;
  background: linear-gradient(135deg, #e8e0d4, #d4c8b8);
  position: relative;
  overflow: hidden;
}
.station-visual-main img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
/* Outputs read as one continuous column under the space shot, same full-bleed
   treatment — the right side is the thing that scrolls. */
.station-outputs-visual {
  display: flex;
  flex-direction: column;
}
.station-output-shot {
  position: relative;
  background: linear-gradient(135deg, #f0e6d8, #e0d6c8);
}
.station-output-shot img {
  width: 100%;
  height: auto;
  display: block;
}
.station-output-shot.empty {
  height: 50vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
}
.station-empty-art {
  font-size: 13px;
  color: var(--brand-blue);
  opacity: 0.4;
}
.station-tags-row {
  display: flex;
  gap: 12px;
  padding: 20px 40px;
  flex-wrap: wrap;
}
.station-tag-item {
  padding: 8px 16px;
  border: 1px solid var(--rule-mid);
  font-size: 12px;
  color: var(--ink);
  opacity: 0.6;
}

.booking-page {
  background: var(--paper);
  min-height: 100vh;
  padding: 100px 60px 60px;
}
.booking-container {
  max-width: 1140px;
  margin: 0 auto;
}
/* Steps scroll on the left; the order summary stays put on the right so what
   you've already chosen never leaves the screen while you're choosing more. */
.booking-layout {
  display: flex;
  align-items: flex-start;
  gap: 48px;
}
.booking-main { flex: 1; min-width: 0; }
.booking-summary {
  width: 320px;
  flex-shrink: 0;
  position: sticky;
  top: 100px;
  background: white;
  border: 1px solid var(--rule-mid);
  padding: 24px;
}
.booking-summary h4 {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 1px;
  color: var(--brand-blue);
  padding-bottom: 14px;
  margin-bottom: 4px;
  border-bottom: 1px solid var(--rule);
}
.summary-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid var(--rule);
  font-size: 13px;
}
.summary-row dt {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.5px;
  color: var(--ink);
  opacity: 0.45;
  padding-top: 2px;
  flex-shrink: 0;
}
.summary-row dd {
  text-align: right;
  font-weight: 600;
  color: var(--brand-blue);
  word-break: break-word;
}
/* Nothing chosen yet reads as a waiting terminal field, not an error. */
.summary-row dd.pending {
  font-weight: 400;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--ink);
  opacity: 0.3;
}
.summary-total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-top: 16px;
  margin-top: 4px;
  font-family: 'Black Han Sans', sans-serif;
  color: var(--brand-blue);
}
.summary-total span:first-child { font-size: 13px; }
.summary-total span:last-child { font-size: 22px; }
.summary-note {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  line-height: 1.7;
  color: var(--ink);
  opacity: 0.4;
  margin-top: 14px;
}
/* Review step: same data, but committed-looking and editable per line. */
.review-block {
  background: white;
  border: 1px solid var(--rule-mid);
  margin-bottom: 24px;
}
.review-line {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  padding: 18px 24px;
  border-bottom: 1px solid var(--rule);
}
.review-line:last-child { border-bottom: none; }
.review-key {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.5px;
  color: var(--ink);
  opacity: 0.5;
  width: 130px;
  flex-shrink: 0;
  padding-top: 2px;
}
.review-val { flex: 1; font-size: 15px; font-weight: 600; color: var(--brand-blue); }
.review-val small {
  display: block;
  font-weight: 400;
  font-size: 12px;
  color: var(--ink);
  opacity: 0.5;
  margin-top: 3px;
}
.review-edit {
  background: none;
  border: none;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--brand-blue);
  cursor: pointer;
  text-decoration: underline;
  flex-shrink: 0;
  padding-top: 3px;
}
.cal-day {
  padding: 8px;
  cursor: pointer;
  transition: background 0.2s;
}
.cal-day:hover { background: var(--brand-light); }
.cal-day.selected { background: var(--brand-blue); color: white; }
.cal-day.muted { opacity: 0.2; pointer-events: none; }
.slot-btn {
  padding: 16px 32px;
  border: 2px solid var(--rule-mid);
  background: white;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
}
.slot-btn:hover { border-color: var(--brand-blue); }
.slot-btn.selected {
  border-color: var(--brand-blue);
  background: var(--brand-blue);
  color: white;
}
.slot-btn span { font-size: 11px; font-weight: 400; opacity: 0.6; }
.slot-btn.selected span { opacity: 0.75; }
.checkout-card {
  background: white;
  border: 1px solid var(--rule-mid);
  padding: 24px;
  margin-bottom: 24px;
}
.checkout-card-title {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--brand-blue);
  margin-bottom: 16px;
}
.checkout-card textarea {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--rule-mid);
  background: white;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  resize: vertical;
}
.checkout-card textarea:focus { outline: none; border-color: var(--brand-blue); }
.policy-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
.policy-table th,
.policy-table td {
  border: 1px solid var(--rule);
  padding: 10px 14px;
  text-align: left;
}
.policy-table th {
  width: 45%;
  font-weight: 400;
  color: var(--ink);
  opacity: 0.6;
  background: rgba(23, 80, 165, 0.03);
}
.policy-table td { font-weight: 600; color: var(--brand-blue); }
.policy-note {
  font-size: 12px;
  line-height: 1.7;
  color: var(--ink);
  opacity: 0.55;
  margin-top: 14px;
}
.summary-divider {
  height: 1px;
  background: var(--rule);
  margin: 20px -24px;
}
.pay-opt {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 0;
  font-size: 13px;
  cursor: pointer;
}
.pay-opt input { width: 16px; height: 16px; }
.consent-all { font-size: 13px; padding-bottom: 4px; }
.consent-child {
  font-size: 12px;
  padding-left: 18px;
  margin-top: 10px;
  opacity: 0.85;
}
.checkout-pay {
  width: 100%;
  margin-top: 20px;
  padding: 16px;
  font-size: 14px;
}
.checkout-pay:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}
.booking-error {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--pink);
  margin-bottom: 14px;
}
.booking-error[hidden] { display: none; }
@media (max-width: 1024px) {
  .booking-layout { flex-direction: column; }
  .booking-summary { width: 100%; position: static; }
}
.booking-title {
  font-family: 'Black Han Sans', sans-serif;
  font-size: 36px;
  margin-bottom: 40px;
}
