}
/* ── ASCII ────────────────────────────────────────────────────────────────
   Terminal texture. `white-space: pre` is doing the real work; anything that
   reflows the glyph grid destroys the art, so no wrapping and no letter-spacing. */
.ascii {
  font-family: 'JetBrains Mono', monospace;
  white-space: pre;
  letter-spacing: 0;
  line-height: 1.1;
  margin: 0;
  overflow-x: auto;
}
.b2b-banner {
  font-size: 11px;
  color: var(--green);
  opacity: 0.85;
  margin-top: 28px;
}
.b2b-banner-sub {
