}
.filter-btn.active {
  background: var(--brand-blue);
  color: white;
  border-color: var(--brand-blue);
}
.filter-btn:not(.active) {
  background: transparent;
  color: var(--brand-blue);
}
.postcard-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 24px;
}
.postcard-item {
  background: white;
  overflow: hidden;
  border: 1px solid var(--rule);
  transition: transform 0.3s;
}
.postcard-item[hidden] { display: none; }
.postcard-badge {
  padding: 8px 16px;
  font-size: 10px;
  font-weight: 600;
}
/* Text left, image right — the arrangement the comp uses on the wall cards. */
.postcard-body {
  display: flex;
  gap: 16px;
  padding: 20px;
  align-items: flex-start;
}
.postcard-text { flex: 1; min-width: 0; }
/* Three states: an actual shared photo, a withheld one, or a partner mark.
   Dashed means "nothing real here yet" — solid means a genuine upload. */
.postcard-photo {
  width: 104px;
  aspect-ratio: 1;
  flex-shrink: 0;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  line-height: 1.4;
  text-align: center;
  color: var(--brand-blue);
}
.postcard-photo img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
.postcard-photo.withheld,
.postcard-photo.partner-mark {
  outline: 1px dashed var(--brand-blue);
  outline-offset: -6px;
  opacity: 0.75;
}
.postcard-item:hover {
  transform: translateY(-4px);
}
.postcard-tag-bar {
  height: 4px;
}
.postcard-content {
  padding: 24px;
}
.postcard-content p {
  font-size: 14px;
  line-height: 1.7;
  color: var(--ink);
  opacity: 0.7;
  margin-bottom: 16px;
}
.postcard-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
}
/* Identity mark (account avatar / brand logo) is separate from the photo:
   one says who you are, the other is what you're sharing. They get their own
   privacy choices because they carry different risk. */
.postcard-identity {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}
.postcard-avatar {
  width: 24px; height: 24px;
  flex-shrink: 0;
  background: var(--brand-light);
  border: 1px solid var(--rule-mid);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-family: 'JetBrains Mono', monospace;
  font-size: 8px;
  font-weight: 600;
  color: var(--brand-blue);
}
.postcard-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
/* ── Create-a-postcard form ───────────────────────────────────────────────
   Lives behind "Create yours >>" rather than on the wall itself: the archive
   note and the share consent are decisions you make while writing, not
   standing instructions posted next to other people's cards. */
.pc-overlay {
  position: fixed;
  inset: 0;
  background: rgba(10, 22, 40, 0.72);
  z-index: 200;
  display: none;
  align-items: flex-start;
  justify-content: center;
  padding: 40px 20px;
  overflow-y: auto;
}
.pc-overlay.open { display: flex; }
.pc-modal {
  background: var(--paper);
  border: 1px solid var(--brand-blue);
  width: 100%;
  max-width: 560px;
  padding: 32px;
}
.pc-modal h2 {
  font-family: 'Black Han Sans', sans-serif;
  font-size: 22px;
  color: var(--brand-blue);
  margin-bottom: 4px;
}
.pc-modal .pc-lead {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--brand-blue);
  opacity: 0.55;
  margin-bottom: 24px;
}
.pc-field { margin-bottom: 18px; }
.pc-label {
  display: block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.5px;
  color: var(--brand-blue);
  margin-bottom: 8px;
}
.pc-field input[type="text"],
.pc-field textarea {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--rule-mid);
  background: white;
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: var(--ink);
}
.pc-field textarea { resize: vertical; min-height: 96px; }
.pc-field input[type="text"]:focus,
.pc-field textarea:focus { outline: none; border-color: var(--brand-blue); }
.pc-types { display: flex; gap: 8px; flex-wrap: wrap; }
.pc-type {
  padding: 8px 16px;
  border: 1px solid var(--rule-mid);
  background: none;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--brand-blue);
  cursor: pointer;
  transition: all 0.2s;
}
.pc-type.active {
  background: var(--brand-blue);
  color: white;
  border-color: var(--brand-blue);
}
/* Upload slot. Optional by design — see the consent note in the form. */
.pc-drop {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px;
  border: 1px dashed var(--rule-strong);
  cursor: pointer;
}
.pc-drop:hover { background: rgba(23, 80, 165, 0.04); }
.pc-drop input[type="file"] { display: none; }
.pc-preview {
  width: 56px; height: 56px;
  flex-shrink: 0;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'JetBrains Mono', monospace;
  font-size: 18px;
  color: var(--brand-blue);
  overflow: hidden;
}
.pc-preview img { width: 100%; height: 100%; object-fit: cover; }
.pc-drop-text {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--brand-blue);
  opacity: 0.7;
  line-height: 1.6;
}
.pc-consent {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 13px;
  cursor: pointer;
  line-height: 1.5;
}
.pc-consent input { width: 16px; height: 16px; margin-top: 2px; flex-shrink: 0; }
.pc-note {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--brand-blue);
  opacity: 0.5;
  line-height: 1.7;
  margin-top: 10px;
  padding-left: 26px;
}
/* Destination picker. Public and private are genuinely different journeys —
   different required fields, different consequences — so it leads the form. */
.pc-dest {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 24px;
}
.pc-dest-opt {
  padding: 14px;
  border: 1px solid var(--rule-mid);
  background: none;
  text-align: left;
  cursor: pointer;
  transition: all 0.2s;
}
.pc-dest-opt.active {
  border-color: var(--brand-blue);
  background: rgba(23, 80, 165, 0.06);
}
.pc-dest-opt strong {
  display: block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--brand-blue);
  margin-bottom: 5px;
}
.pc-dest-opt span {
  font-size: 11px;
  line-height: 1.5;
  color: var(--ink);
  opacity: 0.6;
}
.pc-field[hidden], .pc-dest-opt[hidden] { display: none; }
.pc-uploads { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media (max-width: 520px) {
  .pc-dest, .pc-uploads { grid-template-columns: 1fr; }
}
.pc-actions {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid var(--rule);
}
.pc-cancel {
  background: none;
  border: 1px solid var(--rule-mid);
  color: var(--brand-blue);
  padding: 12px 24px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}
.postcard-author {
  color: var(--brand-blue);
  font-weight: 600;
}
.postcard-date {
  color: var(--ink);
  opacity: 0.35;
}

.support-page {
