  padding: 12px 16px;
  width: 100%;
  max-width: 400px;
  margin-bottom: 16px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  border-radius: 4px;
}
.b2b-input::placeholder {
  color: var(--green);
